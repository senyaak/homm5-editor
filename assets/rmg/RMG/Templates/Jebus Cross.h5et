<?xml version="1.0" encoding="UTF-8"?>
<!-- Jebus Cross, the way Heroes III's HotA describes it: one rich zone in the
     middle and a start zone for each player around it, each joined to the
     middle by a strong guard and to nothing else. Nothing here says WHERE a
     zone goes; the layout below reads the graph and puts the players at the
     edges and the treasure between them. An .h5et is our template format:
     the game's RMGTemplate plus the fields of our own the game's serialiser
     does not know (ZoneLayout on the template, Objects on a zone). -->
<RMGTemplate>
	<NameFileRef href=""/>
	<DescriptionFileRef href=""/>
	<Name>Jebus Cross</Name>
	<ZoneLayout>Voronoi</ZoneLayout>
	<Zones>
		<Item>
			<Index>1</Index>
			<Setting>RACE_RANDOM_TYPE</Setting>
			<CanBeWater>false</CanBeWater>
			<Size>40</Size>
			<CanBePlayerStart>false</CanBePlayerStart>
			<Town>true</Town>
			<TownGuardStrenght>3</TownGuardStrenght>
			<Mines>
				<Item>2</Item>
				<Item>1</Item>
				<Item>2</Item>
				<Item>1</Item>
				<Item>1</Item>
				<Item>1</Item>
				<Item>2</Item>
			</Mines>
			<AbandonedMines>0</AbandonedMines>
			<Dwellings>
				<Item>0</Item>
				<Item>0</Item>
				<Item>0</Item>
				<Item>1</Item>
				<Item>1</Item>
				<Item>1</Item>
				<Item>0</Item>
			</Dwellings>
			<UpgBuildingsDensity>40</UpgBuildingsDensity>
			<TreasureDensity>40</TreasureDensity>
			<TreasureChestDensity>5</TreasureChestDensity>
			<Prisons>0</Prisons>
			<LandCartographer>0</LandCartographer>
			<ShopPoints>10</ShopPoints>
			<ShrinePoints>10</ShrinePoints>
			<LuckMoralBuildingsDensity>60</LuckMoralBuildingsDensity>
			<ResourceBuildingsDensity>80</ResourceBuildingsDensity>
			<TreasureBuildingPoints>10</TreasureBuildingPoints>
			<TreasureBlocksTotalValue>40000</TreasureBlocksTotalValue>
			<DenOfThieves>0</DenOfThieves>
			<RedwoodObservatoryDensity>0</RedwoodObservatoryDensity>
			<BuffPoints>0</BuffPoints>
			<!-- Ours: the rich middle has a Dragon Utopia, guarded, and one only;
			     the Objects list is what the game's format cannot say (template.ts). -->
			<Objects>
				<Item>
					<Href>/MapObjects/Dragon_Utopia.(AdvMapBuildingShared).xdb</Href>
					<Min>1</Min>
					<Max>1</Max>
					<GuardStrenght>30</GuardStrenght>
				</Item>
			</Objects>
		</Item>
		<Item>
			<Index>2</Index>
			<Setting>RACE_RANDOM_TYPE</Setting>
			<CanBeWater>false</CanBeWater>
			<Size>30</Size>
			<CanBePlayerStart>true</CanBePlayerStart>
			<Town>true</Town>
			<TownGuardStrenght>1</TownGuardStrenght>
