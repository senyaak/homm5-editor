{
  "name": "homm5-editor",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "Experimental map/campaign editor for Heroes of Might and Magic 5 (Tribes of the East)",
  "main": "electron/main.ts",
  "imports": {
    "#core/*": "./renderer/core/*",
    "#viewport/*": "./renderer/viewport/*",
    "#features/*": "./renderer/features/*",
    "#src/*": "./src/*",
    "#electron/*": "./electron/*"
  },
  "scripts": {
    "start": "npm run build:renderer && electron .",
    "inspect": "node tools/inspect-terrain.js",
    "test-terrain": "node tools/test-terrain.js",
    "test-terrain-write": "node tools/test-terrain-write.ts",
    "test-terrain-blank": "node tools/test-terrain-blank.ts",
    "test-blank-map": "node tools/test-blank-map.ts",
    "test-new-map": "node tools/test-new-map.ts",
    "test-terrain-layer": "node tools/test-terrain-layer.ts",
    "test-terrain-plane": "node tools/test-terrain-plane.ts",
    "test-pak": "node tools/test-pak.js",
    "test-map": "node tools/test-map.js",
    "test-watch": "node tools/test-watch.ts",
    "mesh-audit": "node tools/mesh-audit.ts",
    "test-objects": "node tools/test-objects.ts",
    "test-scene": "node tools/test-scene.ts",
    "test-registry": "node tools/test-registry.ts",
    "test-schema": "node tools/test-schema.ts",
    "test-campaign": "node tools/test-campaign.ts",
    "test-objects-schema": "node tools/test-objects-schema.ts",
    "test-tree": "node tools/test-tree.ts",
    "test-lua-lint": "node tools/test-lua-lint.ts",
    "test-dialog-scene": "node tools/test-dialog-scene.ts",
    "camera-shape": "node tools/camera-shape.ts",
    "scene-stage": "node tools/scene-stage.ts",
    "view-dialog-scene": "node tools/view-dialog-scene.ts",
    "test-history": "node tools/test-history.ts",
    "test-assets": "node tools/test-assets.ts",
    "test-creature-mod": "node tools/test-creature-mod.ts",
    "test-dwellings": "node tools/test-dwellings.ts",
    "test-buildings": "node tools/test-buildings.ts",
    "test-heroes": "node tools/test-heroes.ts",
    "test-creature-limit": "node tools/test-creature-limit.ts",
    "units-mod": "node tools/units-mod.ts",
    "creature-limit": "node tools/creature-limit.ts",
    "pak": "node tools/pak-cli.js",
    "extract-fixture": "node tools/extract-fixture.ts",
    "diff-terrain": "node tools/diff-terrain.ts",
    "diff-objects": "node tools/diff-objects.ts",
    "diff-map": "node tools/diff-map.ts",
    "pack-c1m1": "node tools/pack-c1m1.ts",
    "make-pwl": "node tools/make-pwl.ts",
    "script-api": "node tools/script-api.ts",
    "build-api": "node tools/build-api.ts",
    "object-shape": "node tools/object-shape.ts",
    "terrain-shape": "node tools/terrain-shape.ts",
    "unpack-data": "node tools/unpack-data.ts",
    "typecheck": "tsc --noEmit",
    "test": "node tools/test-all.ts",
    "test-e2e": "playwright test",
    "test-e2e-fast": "playwright test \"e2e/[^/]+\\.spec\\.ts$\"",
    "test-e2e-nodata": "playwright test --grep @nodata",
    "build:renderer": "node tools/build-renderer.ts",
    "build:app": "node tools/build-app.ts",
    "dist": "node tools/build-app.ts && node tools/package-app.ts",
    "harness": "npm run build:renderer && node tools/make-harness.js && node tools/serve-harness.js",
    "watch:renderer": "node tools/build-renderer.ts --watch",
    "object-schema": "node tools/object-schema.ts",
    "object-defaults": "node tools/object-defaults.ts",
    "test-defaults": "node tools/test-defaults.ts",
    "test-gif": "node tools/test-gif.ts",
    "test-gr2": "node tools/test-gr2.ts",
    "test-oodle": "node tools/test-oodle.ts",
    "test-effects": "node tools/test-effects.ts",
    "test-idle": "node tools/test-idle.ts",
    "test-artifact-mod": "node tools/test-artifact-mod.ts",
    "test-artifact-limit": "node tools/test-artifact-limit.ts",
    "test-artifact-set": "node tools/test-artifact-set.ts",
    "test-artifact-effects": "node tools/test-artifact-effects.ts",
    "build-native": "node tools/build-native.ts",
    "install-native": "node tools/install-native.ts",
    "test-exe-import": "node tools/test-exe-import.ts",
    "test-typespec": "node tools/test-typespec.ts",
    "unwrap-exe": "node tools/unwrap-exe.ts",
    "test-exe-unwrap": "node tools/test-exe-unwrap.ts",
    "test-first-run": "node tools/test-first-run.ts",
    "mod-paths": "node tools/mod-paths.ts",
    "test-mod-paths": "node tools/test-mod-paths.ts",
    "test-map-source": "node tools/test-map-source.ts",
    "lua-registry": "node tools/reverse/lua-registry.ts",
    "test-lua-registry": "node tools/reverse/lua-registry.ts --check",
    "test-artifact-scripts": "node tools/test-artifact-scripts.ts",
    "e2e-live": "node tools/e2e-live.ts"
  },
  "dependencies": {
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/theme-one-dark": "^6.1.3",
    "codemirror": "^6.0.2",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.0.4",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "@types/three": "^0.185.1",
    "@zigc/cli": "^0.16.0",
    "electron": "^43.1.1",
    "esbuild": "^0.28.1",
    "iced-x86": "^1.21.0",
    "typescript": "^7.0.2"
  }
}
