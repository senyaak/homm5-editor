  "name": "H5ECanLearnSpell",
  "params": "hero, spell",
  "group": "Ours · Heroes and spells",
  "summary": "Whether a hero may learn a spell now — school, skill, mastery and level, as the game decides.",
  "args": [
   {
    "name": "hero",
    "type": "name",
