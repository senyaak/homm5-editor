# Game assets extracted for testing — do not commit copyrighted content
*.log
node_modules/
renderer/scene-view.html
renderer/terrain-view.html
data-unpacked/
# ...and any copy of it set aside by hand. It is game content either way.
data-unpacked.*/

# built by tools/build-renderer.ts: the page assembled from renderer/page.html
# + renderer/parts/, and the bundle esbuild makes of renderer/app.ts
renderer/index.html
renderer/app.js
renderer/app.js.map
renderer/harness.html

# The editor's own scratch space: unpacked archives, undo history. Rebuildable,
# and it holds game content, so it must never be committed.
_tmp/

# Where this machine keeps the game. One person's paths, nobody else's — the
# committed file is .env.example, which says what belongs in it. `.env.test` is
# the same file for a `--setup-test` run, and holds a sandbox's paths.
.env
.env.test

# The packaged editor: build/ is the bundled app tree, dist/ the exe folder.
# Both are generated by `npm run dist` from what is committed here.
build/
dist/

# Playwright e2e artifacts (screenshots, traces, reports)
test-results/
playwright-report/
.playwright/

# Steamless, downloaded on demand by `npm run unwrap-exe` — somebody else's tool,
# not ours to redistribute.
tools/vendor/
__pycache__/

native/build/
